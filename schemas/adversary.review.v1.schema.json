{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adversary.dev/schemas/adversary.review.v1.schema.json",
  "title": "Adversary review envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "result"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "result": { "$ref": "#/$defs/reviewResult" }
  },
  "$defs": {
    "reviewSource": {
      "description": "The SDK additionally enforces a combined 32768-byte UTF-8 budget for output and JSON-serialized data; JSON Schema maxLength limits characters only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "status", "summary"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": ["passed", "findings", "error", "partial", "unavailable"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "output": {
          "type": "string",
          "maxLength": 32768
        },
        "data": {
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        },
        "version": {
          "type": "string",
          "maxLength": 200
        },
        "scope": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "headSha": {
          "type": "string",
          "maxLength": 100
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2000
        },
        "reviewer": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "metadata": { "type": "object" },
    "adversary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "version": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "filesScanned": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "message": { "type": "string" },
        "snippet": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" }
      },
      "dependentRequired": { "endLine": ["line"] }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "summary"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "severity", "confidence", "summary", "evidence"],
      "properties": {
        "sourceIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
        },
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "ruleId": { "type": "string" },
        "groupKey": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "category": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "whyItMatters": { "type": "string" },
        "impact": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "recommendation": { "type": "string" },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "estimate": { "type": "string" },
            "complexity": { "type": "string" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "reviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adversary", "target", "positives", "observations", "findings", "suppressed"],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/reviewSource" }
        },
        "adversary": { "$ref": "#/$defs/adversary" },
        "target": { "$ref": "#/$defs/target" },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk"],
          "properties": {
            "risk": { "enum": ["none", "low", "medium", "high", "critical"] },
            "summary": { "type": "string" }
          }
        },
        "positives": { "type": "array", "items": { "$ref": "#/$defs/note" } },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/note" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "opinion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "ship": { "type": "boolean" },
            "summary": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        "suppressed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observations", "findings"],
          "properties": {
            "observations": { "type": "integer", "minimum": 0 },
            "findings": { "type": "integer", "minimum": 0 }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buildMs": { "type": "integer", "minimum": 0 },
            "startupMs": { "type": "integer", "minimum": 0 },
            "scanMs": { "type": "integer", "minimum": 0 },
            "totalMs": { "type": "integer", "minimum": 0 }
          }
        },
        "suppressedFindings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "rawObservations": {}
      }
    }
  }
}
